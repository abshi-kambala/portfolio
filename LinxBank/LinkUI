<style>
/* --- Root Variables & Basic Setup --- */
@import url('https://fonts.googleapis.com/css2?family=Nunito:wght@700&display=swap');

:root {
    --bg: #ffefe6;
    --card-bg: #ffffff;
    --input-bg: #fff9f5;
    --border: #f0d9ce;
    --text: #333333;
    --accent: #e18c4f;
    --bot-bg: #fdf6f1;
    --radius: 16px;
    --shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
}

html, body {
    margin: 0;
    padding: 0;
    height: 100%;
    font-family: "Segoe UI", sans-serif;
    background: var(--bg);
}

/* --- Main Chat Container Layout --- */
.chat-page-container {
    display: flex;
    flex-direction: column;
    height: 100vh; /* Use viewport height to fill the screen */
    max-width: 768px; /* Constrain width for better readability */
    margin: 0 auto;
    background: var(--card-bg);
    box-shadow: var(--shadow);
}

/* --- Scrolling Message Area --- */
.chat-messages-area {
    flex: 1; /* Takes up all available vertical space */
    overflow-y: auto; /* Enables vertical scrolling for messages */
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
}

/* --- Chat Message & Bubble Styling --- */
.chat-message {
    display: flex;
    max-width: 85%;
}

.chat-bubble {
    padding: 12px 18px;
    border-radius: var(--radius);
    color: var(--text);
    line-height: 1.5;
}

/* --- User messages --- */
.user-message {
    align-self: flex-end;
}

.user-message .chat-bubble {
    background: var(--accent);
    color: white;
    border-bottom-right-radius: 4px; /* Classic chat bubble tail effect */
}

/* --- Bot messages --- */
.bot-message {
    align-self: flex-start;
}

.bot-message .chat-bubble {
    background: var(--bot-bg);
    border: 1px solid var(--border);
    border-bottom-left-radius: 4px; /* Classic chat bubble tail effect */
}

/* --- Styling for result items --- */
.result-item {
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
}

.result-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
}
.result-item-title {
    font-weight: 600;
    margin-bottom: 12px;
}


/* --- Input Area at Bottom --- */
.chat-input-area {
    display: flex;
    align-items: center;
    padding: 12px 20px;
    gap: 12px;
    border-top: 1px solid var(--border);
    background-color: var(--card-bg);
}

.chat-input {
    flex: 1;
    border: 1px solid var(--border);
    padding: 12px 16px;
    font-size: 16px;
    background-color: var(--input-bg);
    color: var(--text);
    border-radius: var(--radius);
    outline: none;
    transition: border-color 0.2s;
}

.chat-input:focus {
    border-color: var(--accent);
}

.send-button {
    background: var(--accent);
    border: none;
    color: white;
    padding: 12px 18px;
    border-radius: var(--radius);
    cursor: pointer;
    font-size: 16px;
    font-family: 'Nunito', sans-serif;
    font-weight: 700;
    letter-spacing: 0.5px;
    transition: opacity 0.2s;
}

.send-button:hover {
    opacity: 0.85;
}
</style>

<div class="chat-page-container">
    <div class="chat-messages-area">

        <div class="chat-message user-message">
            <div class="chat-bubble">
                @userQuery
            </div>
        </div>

        <div class="chat-message bot-message">
            <div class="chat-bubble">
                <div class="result-item-title">Results for "@userQuery":</div>
                @foreach (var item in botResults)
                {
                    <div class="result-item">@item</div>
                }
            </div>
        </div>

    </div>

    <div class="chat-input-area">
        <input class="chat-input" placeholder="Ask something..." />
        <button class="send-button">Send</button>
    </div>
</div>
