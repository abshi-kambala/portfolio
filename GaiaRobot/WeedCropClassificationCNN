import tensorflow as tf
import tensorflow_datasets as tfds
import matplotlib.pyplot as plt
import numpy as np
import os
import zipfile
from google.colab import files


# Upload and extract your Roboflow crop dataset zip

uploaded = files.upload()  # select crops.v3i.folder.zip
zip_path = list(uploaded.keys())[0]
extract_path = "data"

with zipfile.ZipFile(zip_path, 'r') as zip_ref:
    zip_ref.extractall(extract_path)

print("Dataset extracted to:", extract_path)
print(os.listdir(extract_path))


# Load DeepWeeds dataset from TensorFlow Datasets

ds, info = tfds.load("deep_weeds", with_info=True, as_supervised=True)

def preprocess_weed(image, label):
    image = tf.image.resize(image, (224, 224)) / 255.0
    label = tf.cast(tf.ones_like(label), tf.int32)  # weeds = 1
    return image, label

full_ds = ds["train"].map(preprocess_weed, num_parallel_calls=tf.data.AUTOTUNE)

train_size = int(0.8 * info.splits["train"].num_examples)
weed_train = full_ds.take(train_size)
weed_val   = full_ds.skip(train_size)


# Load crop dataset from Roboflow zip

def preprocess_crop(image, label):
    image = tf.image.resize(image, (224, 224)) / 255.0
    label = tf.cast(tf.zeros_like(label), tf.int32)  # crops = 0
    return image, label

crop_train_ds = tf.keras.utils.image_dataset_from_directory(
    os.path.join(extract_path, "train"),
    image_size=(224, 224),
    label_mode="int",
    batch_size=None
).map(preprocess_crop, num_parallel_calls=tf.data.AUTOTUNE)

crop_val_ds = tf.keras.utils.image_dataset_from_directory(
    os.path.join(extract_path, "valid"),
    image_size=(224, 224),
    label_mode="int",
    batch_size=None
).map(preprocess_crop, num_parallel_calls=tf.data.AUTOTUNE)


# Combine datasets using sample_from_datasets

BATCH_SIZE = 8

train_ds = tf.data.Dataset.sample_from_datasets(
    [crop_train_ds, weed_train],
    weights=[0.5, 0.5]
).shuffle(500).batch(BATCH_SIZE).prefetch(tf.data.AUTOTUNE)

val_ds = tf.data.Dataset.sample_from_datasets(
    [crop_val_ds, weed_val],
    weights=[0.5, 0.5]
).batch(BATCH_SIZE).prefetch(tf.data.AUTOTUNE)

print("Train and validation datasets prepared")


# Define CNN Model (MobileNetV2 base)

base_model = tf.keras.applications.MobileNetV2(
    input_shape=(224, 224, 3), include_top=False, weights="imagenet"
)
base_model.trainable = False  # freeze feature extractor

model = tf.keras.Sequential([
    base_model,
    tf.keras.layers.GlobalAveragePooling2D(),
    tf.keras.layers.Dropout(0.3),
    tf.keras.layers.Dense(1, activation="sigmoid")
])

model.compile(
    optimizer=tf.keras.optimizers.Adam(1e-4),
    loss="binary_crossentropy",
    metrics=["accuracy"]
)


# Train model

history = model.fit(
    train_ds,
    validation_data=val_ds,
    epochs=10
)


# Plot Accuracy

plt.plot(history.history["accuracy"], label="Train Accuracy")
plt.plot(history.history["val_accuracy"], label="Val Accuracy")
plt.xlabel("Epochs")
plt.ylabel("Accuracy")
plt.legend()
plt.show()
